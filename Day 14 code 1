#include <stdio.h>

int main() {
    int n;
    long long sum = 0;

    printf("Enter the value of n: ");
    scanf("%d", &n);

    if (n <= 0) {
        printf("Please enter a positive integer.\n");
        return 1;
    }

  
    for (int i = 1; i <= n; i++) {
        sum += (2 * i - 1);
    }

    printf("The sum of the first %d odd numbers is: %lld\n", n, sum);

    return 0;
}
