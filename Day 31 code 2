#include <stdio.h>

int main() {
    int n;
    
    // Get the number of elements
    printf("Enter the number of elements: ");
    scanf("%d", &n);
    
    if (n <= 0) {
        printf("Array must have at least one element.\n");
        return 1;
    }
    
    int arr[n];
    
   
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
    
    int start = 0;
    int end = n - 1;
    
    while (start < end) {
       
        int temp = arr[start];
        arr[start] = arr[end];
        arr[end] = temp;
        
       
        start++;
        end--;
    }
    
    
    printf("The reversed array is: ");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
    
    return 0;
}
