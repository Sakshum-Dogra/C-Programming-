#include <stdio.h>

int main() {
    long long n;

    printf("Enter a positive integer: ");
    scanf("%lld", &n);

    if (n <= 0) {
        printf("Please enter a positive integer greater than 0.\n");
        return 1;
    }

    printf("Factors of %lld are:\n", n);

    
    for (long long i = 1; i * i <= n; i++) {
        if (n % i == 0) {
            printf("%lld ", i);
            
            
            if (i != n / i) {
                printf("%lld ", n / i);
            }
        }
    }
    printf("\n");

    return 0;
}
