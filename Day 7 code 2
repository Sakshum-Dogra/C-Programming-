#include <stdio.h>


int main()
{
    char ch;

    printf("Enter an alphabet: ");
    scanf(" %c", &ch);

   
    if (isalpha(ch))
{
        
        char lower = tolower(ch);

        if (lower == 'a' || lower == 'e' || lower == 'i' || lower == 'o' || lower == 'u')
{
            printf("'%c' is a vowel.\n", ch);
        } 
else
{
            printf("'%c' is a consonant.\n", ch);
        }
    } 
else
{
        printf("'%c' is not an alphabet letter.\n", ch);
    }

    return 0;
}
