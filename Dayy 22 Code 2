#include <stdio.h>

int main() {
    int n;
    double sum = 0.0;
    printf("Enter number of terms (n): ");
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        if (i == 1) {
            sum += 1.0;
        } else {
            sum += (2.0 * i - 1.0) / (2.0 * i - 2.0);
        }
    }

    printf("Sum of %d terms: %.4f\n", n, sum);
    return 0;
}
