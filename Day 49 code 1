#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char str[150];
    
    printf("Enter a full name: ");
    fgets(str, sizeof(str), stdin);
    str[strcspn(str, "\n")] = '\0'; 
    
    printf("Initials: ");
    
  
    if (str[0] != '\0' && str[0] != ' ') {
        printf("%c", toupper(str[0]));
    }
    
  
    for (int i = 1; str[i] != '\0'; i++) {
        
        if (str[i - 1] == ' ' && str[i] != ' ') {
            printf(" %c", toupper(str[i]));
        }
    }
    printf("\n");
    
    return 0;
}
