#include <stdio.h>

int main() {
    long long binary, temp;
    long long complement = 0, place = 1;

    printf("Enter a binary number: ");
    scanf("%lld", &binary);

    temp = (binary < 0) ? -binary : binary;

    if (temp == 0) {
        complement = 1;
    } else {
        while (temp > 0) {
            int bit = temp % 10;

            
            if (bit != 0 && bit != 1) {
                printf("Error: Not a valid binary number.\n");
                return 1;
            }

            int inverted_bit = (bit == 0) ? 1 : 0;
            complement += inverted_bit * place;
            place *= 10;
            temp /= 10;
        }
    }

    printf("1's complement: %lld\n", complement);

    return 0;
}
