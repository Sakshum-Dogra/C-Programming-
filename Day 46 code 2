#include <stdio.h>

int main() {
    char str[150];
    int freq[26] = {0}; 
    char firstRepeating = '\0';
    
    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);
    
  
    for (int i = 0; str[i] != '\0' && str[i] != '\n'; i++) {
        char ch = str[i];
        
       
        if (ch >= 'a' && ch <= 'z') {
            int index = ch - 'a';
            
            
            if (freq[index] > 0) {
                firstRepeating = ch;
                break;
            }
            
           
            freq[index]++;
        }
    }
    
    
    if (firstRepeating != '\0') {
        printf("The first repeating lowercase alphabet is: '%c'\n", firstRepeating);
    } else {
        printf("No repeating lowercase alphabets found in the string.\n");
    }
    
    return 0;
}
