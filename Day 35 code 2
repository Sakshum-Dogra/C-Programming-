#include <stdio.h>


void reverse(int arr[], int start, int end) {
    while (start < end) {
        int temp = arr[start];
        arr[start] = arr[end];
        arr[end] = temp;
        start++;
        end--;
    }
}

int main() {
    int n, k;
    
    
    printf("Enter the number of elements: ");
    scanf("%d", &n);
    
    if (n <= 0) {
        printf("Array must have at least one element.\n");
        return 1;
    }
    
    int arr[n];
    
    
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
   
    printf("Enter the number of positions to rotate (k): ");
    scanf("%d", &k);
    
   
    k = k % n;
    
    if (k > 0) {
       
        reverse(arr, 0, n - 1);
        
       
        reverse(arr, 0, k - 1);
        
       
        reverse(arr, k, n - 1);
    }
    
   
    printf("Array after rotating right by %d positions: ", k);
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
    
    return 0;
}
