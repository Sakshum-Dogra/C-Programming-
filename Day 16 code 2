#include <stdio.h>

int main() {
    long long n, originalNumber, reversedNumber = 0, remainder;

    printf("Enter an integer: ");
    scanf("%lld", &n);

    
    if (n < 0) {
        printf("%lld is not a palindrome number.\n", n);
        return 0;
    }

    originalNumber = n;

    
    while (n != 0) {
        remainder = n % 10;
        reversedNumber = reversedNumber * 10 + remainder;
        n /= 10;
    }

    
    if (originalNumber == reversedNumber) {
        printf("%lld is a palindrome number.\n", originalNumber);
    } else {
        printf("%lld is not a palindrome number.\n", originalNumber);
    }

    return 0;
}
