#include <stdio.h>

int main() {
    char str[250];
    
    printf("Enter a sentence: ");
    fgets(str, sizeof(str), stdin);
    
    int max_len = 0, current_len = 0;
    int start_index = 0, max_start = 0;
    int i = 0;
    
    while (1) {
        
        if (str[i] != ' ' && str[i] != '\t' && str[i] != '\n' && str[i] != '\0') {
            if (current_len == 0) {
                start_index = i; 
            }
            current_len++;
        } else {
           
            if (current_len > max_len) {
                max_len = current_len;
                max_start = start_index;
            }
            current_len = 0; // Reset for the next word
        }
        
       
        if (str[i] == '\0' || str[i] == '\n') {
            break;
        }
        i++;
    }
    
   
    if (max_len > 0) {
        printf("\nThe longest word is: ");
        for (int j = 0; j < max_len; j++) {
            putchar(str[max_start + j]);
        }
        printf("\nLength: %d characters\n", max_len);
    } else {
        printf("\nNo words found in the input.\n");
    }
    
    return 0;
}
