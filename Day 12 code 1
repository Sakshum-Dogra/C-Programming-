#include <stdio.h>

int main() 
{
    int days;
    int fine = 0;

    printf("Enter the number of late days: ");
    scanf("%d", &days);

    if (days < 0) 
{
        printf("Invalid input! Number of days cannot be negative.\n");
    } else if (days == 0) {
        printf("No fine. Book returned on time.\n");
    } else if (days <= 5) {
        fine = days * 2;
        printf("Total Fine: Rs. %d\n", fine);
    } else if (days <= 10) {
        
        fine = (5 * 2) + ((days - 5) * 4);
        printf("Total Fine: Rs. %d\n", fine);
    } else if (days <= 30) {
       
        fine = (5 * 2) + (5 * 4) + ((days - 10) * 6);
        printf("Total Fine: Rs. %d\n", fine);
    } else {
        printf("More than 30 days late: Membership Cancelled.\n");
    }

    return 0;
}
