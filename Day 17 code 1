#include <stdio.h>
#include <math.h>

int main() {
    long long n, originalNumber, temp;
    int digits = 0;
    long long sum = 0;

    printf("Enter an integer: ");
    scanf("%lld", &n);

    
    if (n < 0) {
        printf("%lld is not an Armstrong number.\n", n);
        return 0;
    }

    originalNumber = n;

 
    temp = n;
    if (temp == 0) {
        digits = 1;
    } else {
        while (temp != 0) {
            digits++;
            temp /= 10;
        }
    }

    
    temp = n;
    while (temp != 0) {
        int remainder = temp % 10;
        // round() prevents floating-point precision truncation issues with pow()
        sum += (long long)round(pow(remainder, digits));
        temp /= 10;
    }

 
    if (sum == originalNumber) {
        printf("%lld is an Armstrong number.\n", originalNumber);
    } else {
        printf("%lld is not an Armstrong number.\n", originalNumber);
    }

    return 0;
}
