#include <stdio.h>

int main() 
{
    long long n, reversedNumber = 0, remainder, originalNumber;

    printf("Enter an integer: ");
    scanf("%lld", &n);

    originalNumber = n;

   
    long long temp = (n < 0) ? -n : n;

    while (temp != 0) {
        remainder = temp % 10;
        reversedNumber = reversedNumber * 10 + remainder;
        temp /= 10;
    }

   
    if (originalNumber < 0) {
        reversedNumber = -reversedNumber;
    }

    printf("Reversed Number = %lld\n", reversedNumber);

    return 0;
}
