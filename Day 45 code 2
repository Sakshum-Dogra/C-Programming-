#include <stdio.h>
#include <ctype.h>

int main() {
    char str[150];
    
    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);
    
    
    for (int i = 0; str[i] != '\0' && str[i] != '\n'; i++) {
        if (islower(str[i])) {
            str[i] = toupper(str[i]); 
        } else if (isupper(str[i])) {
            str[i] = tolower(str[i]); 
        }
    }
    
    printf("String with toggled case: %s", str);
    
    return 0;
}
