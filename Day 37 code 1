#include <stdio.h>

int main() {
    int rows, cols;
    
    
    printf("Enter the number of rows: ");
    scanf("%d", &rows);
    printf("Enter the number of columns: ");
    scanf("%d", &cols);
    
    if (rows <= 0 || cols <= 0) {
        printf("Invalid matrix dimensions.\n");
        return 1;
    }
    
    int mat[rows][cols];
    int row_sums[rows]; // Array to store the sum of each row
    
    
    printf("Enter the elements for a %d x %d matrix:\n", rows, cols);
    for (int i = 0; i < rows; i++) {
        row_sums[i] = 0; // Initialize sum for the current row to 0
        for (int j = 0; j < cols; j++) {
            scanf("%d", &mat[i][j]);
            row_sums[i] += mat[i][j]; 
        }
    }
    
    
    printf("\nSum of each row:\n");
    for (int i = 0; i < rows; i++) {
        printf("Row %d sum: %d\n", i + 1, row_sums[i]);
    }
    
    return 0;
}
