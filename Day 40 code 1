#include <stdio.h>

int main() {
    int r, c, i, j;
    
    printf("Enter the number of rows and columns: ");
    scanf("%d %d", &r, &c);
    
    int mat[r][c];
    
    
    printf("Enter elements of the matrix:\n");
    for(i = 0; i < r; ++i) {
        for(j = 0; j < c; ++j) {
            printf("Element a[%d][%d]: ", i + 1, j + 1);
            scanf("%d", &mat[i][j]);
        }
    }
    
   
    printf("\nGiven Matrix:\n");
    for(i = 0; i < r; ++i) {
        for(j = 0; j < c; ++j) {
            printf("%d\t", mat[i][j]);
        }
        printf("\n");
    }
    
   
    printf("\nDiagonal Traversal: ");
    int row = 0, col = 0;
    int direction = 1; // 1 means moving up-right, -1 means moving down-left
    
    for (int k = 0; k < r * c; ++k) {
        printf("%d ", mat[row][col]);
        
        if (direction == 1) {
            if (col == c - 1) {
                row++;
                direction = -1;
            } else if (row == 0) {
                col++;
                direction = -1; 
            } else {
                row--;
                col++;
            }
        } else { 
            if (row == r - 1) {
                col++;
                direction = 1; 
            } else if (col == 0) {
                row++;
                direction = 1; 
            } else {
                row++;
                col--;
            }
        }
    }
    printf("\n");
    
    return 0;
}
