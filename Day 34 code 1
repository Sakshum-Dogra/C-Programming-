#include <stdio.h>

int main() {
    int n, key, pos;
    
    
    printf("Enter the number of elements: ");
    scanf("%d", &n);
    
    if (n < 0) {
        printf("Invalid array size.\n");
        return 1;
    }
    
    
    int arr[n + 1];
    
  
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
    
    printf("Enter the element to insert: ");
    scanf("%d", &key);
    
    printf("Enter the index (0 to %d) where you want to insert: ", n);
    scanf("%d", &pos);
    
   
    if (pos < 0 || pos > n) {
        printf("Invalid position! Index must be between 0 and %d.\n", n);
        return 1;
    }
    
   
    for (int i = n - 1; i >= pos; i--) {
        arr[i + 1] = arr[i];
    }
    
    
    arr[pos] = key;
    
    
    printf("Array after insertion: ");
    for (int i = 0; i <= n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
    
    return 0;
}
