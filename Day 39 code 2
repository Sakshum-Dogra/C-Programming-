#include <stdio.h>

int main() {
    int n, i, j;
    int sum = 0;
    
    printf("Enter the order of the square matrix (e.g., 3 for 3x3): ");
    scanf("%d", &n);
    
    int mat[n][n];
    
  
    printf("Enter elements of the matrix:\n");
    for(i = 0; i < n; ++i) {
        for(j = 0; j < n; ++j) {
            printf("Element a[%d][%d]: ", i + 1, j + 1);
            scanf("%d", &mat[i][j]);
        }
    }
    
   
    for(i = 0; i < n; ++i) {
        sum += mat[i][i];
    }
    
    
    printf("\nSum of the main diagonal elements = %d\n", sum);
    
    return 0;
}
