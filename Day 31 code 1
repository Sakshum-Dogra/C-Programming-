#include <stdio.h>

int main() {
    int n, target, found = 0, index = -1;
    
   
    printf("Enter the number of elements: ");
    scanf("%d", &n);
    
    if (n <= 0) {
        printf("Array must have at least one element.\n");
        return 1;
    }
    
    int arr[n];
    
    
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
    
    printf("Enter the element to search: ");
    scanf("%d", &target);
    
    
    for (int i = 0; i < n; i++) {
        if (arr[i] == target) {
            found = 1;
            index = i;
            break; // Element found, exit the loop early
        }
    }
    
    
    if (found) {
        printf("Element %d found at index %d (Position %d).\n", target, index, index + 1);
    } else {
        printf("Element %d not found in the array.\n", target);
    }
    
    return 0;
}
