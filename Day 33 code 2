#include <stdio.h>

int main() {
    int n, key;
    
  
    printf("Enter the number of elements: ");
    scanf("%d", &n);
    
    if (n < 0) {
        printf("Invalid array size.\n");
        return 1;
    }
    
    
    int arr[n + 1];
    
    
    printf("Enter %d sorted elements (in ascending order):\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
   
    printf("Enter the element to insert: ");
    scanf("%d", &key);
    
    
    int i = n - 1;
    while (i >= 0 && arr[i] > key) {
        arr[i + 1] = arr[i];
        i--;
    }
    
   
    arr[i + 1] = key;
    
    
    printf("Array after insertion: ");
    for (int j = 0; j <= n; j++) {
        printf("%d ", arr[j]);
    }
    printf("\n");
    
    return 0;
}
