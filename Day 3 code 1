#include <stdio.h>

int main()
{
    double celsius, fahrenheit;

    printf("Enter temperature in Celsius: ");
    if (scanf("%lf", &celsius) != 1) {
        printf("Error: Invalid numeric input.\n");
        return 1;
    }

    fahrenheit = (celsius * 9.0 / 5.0) + 32.0;

    printf("%.2f°C is equal to %.2f°F\n", celsius, fahrenheit);

    return 0;
}
