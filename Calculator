#include<stdio.h>
int main()
{
        int a;
        int b;
        int sum;
        int substract;
        int multiply;
        float divide;
        printf("Enter 1st no: ");
        scanf("%d", &a);

        printf("Enter 2nd no: ");
        scanf("%d", &b);

        sum = a + b;
        substract = a - b;
        multiply = a * b;
        divide = (float)a / b;
        printf("The Sum Of the Two is = %d\n", sum);
        printf("The Difference between these are = %d\n", substract);
        printf("The Product of the Two is = %d\n", multiply);
        printf("The Division of the Two is = %.2f\n", divide);

        return 0;

}
