#include <stdio.h>

int main() {
    long long n, sum = 0;

    printf("Enter a positive integer: ");
    scanf("%lld", &n);

   
    if (n <= 1) {
        printf("%lld is not a perfect number.\n", n);
        return 0;
    }

   
    sum = 1;

    
    for (long long i = 2; i * i <= n; i++) {
        if (n % i == 0) {
            sum += i;
            
            if (i * i != n) {
                sum += n / i;
            }
        }
    }

    if (sum == n) {
        printf("%lld is a perfect number.\n", n);
    } else {
        printf("%lld is not a perfect number.\n", n);
    }

    return 0;
}
