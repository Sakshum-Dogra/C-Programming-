#include <stdio.h>

int main() {
    int n, pos;
    
    
    printf("Enter the number of elements: ");
    scanf("%d", &n);
    
    if (n <= 0) {
        printf("Array is empty or invalid size.\n");
        return 1;
    }
    
    int arr[n];
    
    
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
   
    printf("Enter the index (0 to %d) of the element to delete: ", n - 1);
    scanf("%d", &pos);
    
   
    if (pos < 0 || pos >= n) {
        printf("Invalid position! Index must be between 0 and %d.\n", n - 1);
        return 1;
    }
    
    
    for (int i = pos; i < n - 1; i++) {
        arr[i] = arr[i + 1];
    }
    
    
    n--;
    
   
    printf("Array after deletion: ");
    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
    
    return 0;
}
