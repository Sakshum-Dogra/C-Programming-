#include <stdio.h>

int main() {
    long long n, temp, sum = 0;

    printf("Enter a positive integer: ");
    scanf("%lld", &n);

    if (n <= 0) {
        printf("%lld is not a strong number.\n", n);
        return 0;
    }

    temp = n;

    while (temp > 0) {
        int digit = temp % 10;

        /
        long long fact = 1;
        for (int i = 1; i <= digit; i++) {
            fact *= i;
        }

        sum += fact;
        temp /= 10;
    }

    if (sum == n) {
        printf("%lld is a strong number.\n", n);
    } else {
        printf("%lld is not a strong number.\n", n);
    }

    return 0;
}

