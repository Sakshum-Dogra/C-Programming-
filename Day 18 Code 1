#include <stdio.h>

int main() {
    int a, b;
    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);

    int n1 = (a < 0) ? -a : a;
    int n2 = (b < 0) ? -b : b;

    while (n2 != 0) {
        int temp = n2;
        n2 = n1 % n2;
        n1 = temp;
    }

    printf("HCF of %d and %d is: %d\n", a, b, n1);
    return 0;
}
