#include <stdio.h>
#include <stdlib.h>

int main() {
    long long num;
    
    printf("Enter an integer: ");
    scanf("%lld", &num);
    
    
    if (num < 0) {
        num = -num;
    }
    
    
    if (num == 0) {
        printf("The digit that occurs the most times is: 0 (appears 1 time)\n");
        return 0;
    }
    
    
    int freq[10] = {0};
    
    long long temp = num;
    while (temp > 0) {
        int digit = temp % 10;
        freq[digit]++;
        temp /= 10;
    }
    
   
    int max_freq = 0;
    int most_frequent_digit = 0;
    
    for (int i = 0; i < 10; i++) {
        if (freq[i] > max_freq) {
            max_freq = freq[i];
            most_frequent_digit = i;
        }
    }
    
    printf("The digit that occurs the most times is: %d (appears %d times)\n", most_frequent_digit, max_freq);
    
    return 0;
}
