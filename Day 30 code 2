#include <stdio.h>

int main() {
    int n, pos_count = 0, neg_count = 0, zero_count = 0;
    
   
    printf("Enter the number of elements: ");
    scanf("%d", &n);
    
    if (n <= 0) {
        printf("Array must have at least one element.\n");
        return 1;
    }
    
    int arr[n];
    
   
    printf("Enter %d elements:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    
   
    for (int i = 0; i < n; i++) {
        if (arr[i] > 0) {
            pos_count++; 
        } else if (arr[i] < 0) {
            neg_count++; 
        } else {
            zero_count++; 
        }
    }
    
    
    printf("Number of positive elements: %d\n", pos_count);
    printf("Number of negative elements: %d\n", neg_count);
    printf("Number of zero elements: %d\n", zero_count);
    
    return 0;
}
