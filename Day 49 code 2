#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main() {
    char str[150];
    
    printf("Enter a full name: ");
    fgets(str, sizeof(str), stdin);
    str[strcspn(str, "\n")] = '\0'; 
    
    int len = strlen(str);
    
   
    while (len > 0 && str[len - 1] == ' ') {
        str[len - 1] = '\0';
        len--;
    }
    
    if (len == 0) {
        printf("No name entered.\n");
        return 0;
    }
    
   
    int last_space = -1;
    for (int i = len - 1; i >= 0; i--) {
        if (str[i] == ' ') {
            last_space = i;
            break;
        }
    }
    
    printf("Formatted Name: ");
    
   
    if (last_space == -1) {
        printf("%s\n", str);
    } else {
       
        if (str[0] != ' ') {
            printf("%c. ", toupper(str[0]));
        }
        
       
        for (int i = 1; i < last_space; i++) {
            if (str[i - 1] == ' ' && str[i] != ' ') {
                printf("%c. ", toupper(str[i]));
            }
        }
        
       
        printf("%s\n", &str[last_space + 1]);
    }
    
    return 0;
}
