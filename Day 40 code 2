#include <stdio.h>

int main() {
    int r1, c1, r2, c2, i, j, k;
    
    
    printf("Enter rows and columns for the first matrix: ");
    scanf("%d %d", &r1, &c1);
    
 
    printf("Enter rows and columns for the second matrix: ");
    scanf("%d %d", &r2, &c2);
    
    
    if (c1 != r2) {
        printf("\nError! Column of first matrix must equal row of second matrix.\n");
        printf("Multiplication is not possible.\n");
        return 1;
    }
    
    int mat1[r1][c1], mat2[r2][c2], product[r1][c2];
    
   
    printf("\nEnter elements of the first matrix (%dx%d):\n", r1, c1);
    for (i = 0; i < r1; ++i) {
        for (j = 0; j < c1; ++j) {
            printf("Element a[%d][%d]: ", i + 1, j + 1);
            scanf("%d", &mat1[i][j]);
        }
    }
    
    
    printf("\nEnter elements of the second matrix (%dx%d):\n", r2, c2);
    for (i = 0; i < r2; ++i) {
        for (j = 0; j < c2; ++j) {
            printf("Element b[%d][%d]: ", i + 1, j + 1);
            scanf("%d", &mat2[i][j]);
        }
    }
    
   
    for (i = 0; i < r1; ++i) {
        for (j = 0; j < c2; ++j) {
            product[i][j] = 0;
        }
    }
    
    
    for (i = 0; i < r1; ++i) {
        for (j = 0; j < c2; ++j) {
            for (k = 0; k < c1; ++k) {
                product[i][j] += mat1[i][k] * mat2[k][j];
            }
        }
    }
    
    
    printf("\nResultant Matrix after Multiplication (%dx%d):\n", r1, c2);
    for (i = 0; i < r1; ++i) {
        for (j = 0; j < c2; ++j) {
            printf("%d\t", product[i][j]);
        }
        printf("\n");
    }
    
    return 0;
}
