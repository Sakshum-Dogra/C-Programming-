#include <stdio.h>

int main() 
{
    long long n, temp;
    int sum = 0;

    printf("Enter an integer: ");
    scanf("%lld", &n);

    
    temp = (n < 0) ? -n : n;

    while (temp != 0) {
        sum += temp % 10; // Extract and add the last digit
        temp /= 10;       // Remove the last digit
    }

    printf("Sum of digits of %lld is: %d\n", n, sum);

    return 0;
}
