#include <stdio.h>

int main() 
{
    double cp, sp, amount, percentage;

    printf("Enter Cost Price (CP): ");
    scanf("%lf", &cp);

    printf("Enter Selling Price (SP): ");
    scanf("%lf", &sp);

   
    if (cp <= 0) {
        printf("Invalid Cost Price! It must be greater than 0.\n");
        return 1;
    }

    if (sp > cp) 
{
        amount = sp - cp;
        percentage = (amount / cp) * 100.0;
        printf("Profit = %.2f\n", amount);
        printf("Profit Percentage = %.2f%%\n", percentage);
    }
else if (cp > sp)
{
        amount = cp - sp;
        percentage = (amount / cp) * 100.0;
        printf("Loss = %.2f\n", amount);
        printf("Loss Percentage = %.2f%%\n", percentage);
    } 
else
{
        printf("No Profit, No Loss.\n");
    }

    return 0;
}
